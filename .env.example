# ============================================================
# Phone Shop Environment Configuration Reference
# ============================================================

# ------------------------------------------------------------
# Application & Server Settings
# ------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------
# Frontend URLs (for dynamic CORS origin whitelist in NestJS)
# Supports comma-separated origins.
# http://localhost:5173, http://localhost:3000, *.vercel.app, and *.pages.dev are automatically permitted.
# ------------------------------------------------------------
FRONTEND_URL=https://your-domain.vercel.app

# ------------------------------------------------------------
# Database (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/phoneshop?schema=public

# ------------------------------------------------------------
# JWT Authentication & Tokens
# ------------------------------------------------------------
JWT_SECRET=super-secure-jwt-secret-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secure-refresh-jwt-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------
# Redis (Caching, Queue BullMQ, Hold Expiry)
# ------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Must be 'true' or the app silently falls back to in-memory queues
# (hold-expiry jobs would never fire)
REDIS_ENABLED=true

# ------------------------------------------------------------
# Rate Limiting (NestJS Throttler)
# TTL in milliseconds (e.g. 60000 = 1 minute)
# LIMIT = maximum number of requests per TTL window
# ------------------------------------------------------------
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

# ------------------------------------------------------------
# Cloud Storage (Supabase Storage)
# Leave unset or empty to run storage in mock mode
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=phoneshop

# ------------------------------------------------------------
# Cloudflare R2 (media) — Supabase keeps only Postgres data
# Real values go in local backend/.env only (gitignored), never here
# ------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=phoneshop
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxx.r2.dev
STORAGE_PROVIDER=r2

# ------------------------------------------------------------
# Email Notification (SMTP / Nodemailer)
# Leave unset to run email in mock/console mode
# ------------------------------------------------------------
EMAIL_FROM="Phone Shop <no-reply@phoneshop.vn>"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

# ------------------------------------------------------------
# Payment Gateways (Optional)
# ------------------------------------------------------------
# VNPay Sandbox credentials
VNPAY_TMN_CODE=SANDBOX1
VNPAY_HASH_SECRET=SECRETKEYSANDBOX
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://phoneshop-blond.vercel.app/order/vnpay-return

# VietQR Default Configuration
VIETQR_BANK_ID=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=NGUYEN VAN A

# ------------------------------------------------------------
# AI Chatbot (Gemini Flash via backend proxy)
# Get key at https://aistudio.google.com/apikey
# Backend holds the key; frontend never calls Gemini directly.
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CHATBOT_ENABLED=true
