# ============================================================
# MobileCommerce Backend — Environment Template
# Copy to .env.development (local) or set on VPS (.env.production).
# NEVER commit real secrets. All values below are placeholders.
# ============================================================

NODE_ENV=development
PORT=3000

# ------------------------------------------------------------
# Database (PostgreSQL / Supabase pooler)
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[ref]:[password]@[pool-host]:5432/postgres"

# ------------------------------------------------------------
# JWT Authentication
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET="change-me-64-hex-chars-min"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-64-hex-chars-min"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------
# Rate Limiting (NestJS Throttler)
# TTL in ms (60000 = 1 minute), LIMIT = max requests per window
# ------------------------------------------------------------
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

# ------------------------------------------------------------
# CORS & Frontend
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Production example: FRONTEND_URL=https://phoneshop-blond.vercel.app

# ------------------------------------------------------------
# Supabase (storage)
# ------------------------------------------------------------
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[supabase-service-role-key]"
SUPABASE_STORAGE_BUCKET="mobile-commerce"

# ------------------------------------------------------------
# Email via Resend SMTP (Nodemailer)
# Verify tutorhub.id.vn in Resend and create a sending API key.
# Port 2465 uses implicit TLS; Render Free blocks 25, 465 and 587.
# ------------------------------------------------------------
EMAIL_FROM="PhoneShop <no-reply@tutorhub.id.vn>"
EMAIL_HOST="smtp.resend.com"
EMAIL_PORT=2465
EMAIL_SECURE=true
EMAIL_USER="resend"
# Use the Resend API key (re_...) as the SMTP password.
# Empty = console mock in development; sending fails in production.
EMAIL_PASS=""

# ------------------------------------------------------------
# VietQR
# ------------------------------------------------------------
VIETQR_BANK_ID="970422"
VIETQR_ACCOUNT_NO="0123456789"
VIETQR_ACCOUNT_NAME="NGUYEN VAN A"

# ------------------------------------------------------------
# VNPay Sandbox
# ------------------------------------------------------------
VNPAY_TMN_CODE="[vnpay-tmn-code]"
VNPAY_HASH_SECRET="[vnpay-hash-secret]"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:5173/order/vnpay-return"

# ------------------------------------------------------------
# Google OAuth (canonical keys)
# Only basic sign-in scopes: openid email profile (no Google refresh token).
# GOOGLE_CLIENT_ID must match the frontend VITE_GOOGLE_CLIENT_ID.
# Redirect URI must match an authorized redirect URI in Google Console.
# GOOGLE_CLIENT_SECRET is backend-only; never expose it via VITE_* variables.
# ------------------------------------------------------------
GOOGLE_CLIENT_ID="[google-client-id].apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="[google-client-secret]"
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/oauth/callback"

# ------------------------------------------------------------
# Cloudflare R2 (media storage)
# ------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID="[r2-account-id]"
CLOUDFLARE_R2_BUCKET="[r2-bucket]"
CLOUDFLARE_R2_ACCESS_KEY_ID="[r2-access-key-id]"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="[r2-secret-access-key]"
CLOUDFLARE_R2_PUBLIC_URL="https://[public-id].r2.dev"
STORAGE_PROVIDER=r2

# ------------------------------------------------------------
# Gemini (AI chatbot)
# ------------------------------------------------------------
GEMINI_API_KEY="[gemini-api-key]"
GEMINI_MODEL=gemini-3.1-flash-lite
# AI provider: gemini | groq (Groq OpenAI-compatible, cần key riêng)
CHATBOT_PROVIDER=gemini
GROQ_API_KEY="[groq-api-key]"
GROQ_MODEL=openai/gpt-oss-120b
# Optional: GROQ_BASE_URL=https://api.groq.com/openai/v1
# Dev local qua 9router (OpenAI-compatible): khi NODE_ENV khác production/test
# và không set CHATBOT_PROVIDER thì tự dùng 9router.
# NINEROUTER_API_KEY="[9router-key]"
# NINEROUTER_MODEL=ag/gemini-3.8-flash-high
# NINEROUTER_BASE_URL=http://localhost:20128/v1
CHATBOT_ENABLED=true
# Optional: ghi đè system prompt của AI (mặc định dùng SHOP_SYSTEM_PROMPT trong code)
# CHATBOT_SYSTEM_PROMPT="Bạn là trợ lý AI PhoneShop..."
