# ============================================================
# MobileCommerce Backend — Environment Template
# Copy to .env.development (local) or set on VPS (.env.production).
# NEVER commit real secrets. All values below are placeholders.
# ============================================================

NODE_ENV=development
PORT=3000

# ------------------------------------------------------------
# Database (PostgreSQL / Supabase pooler)
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[ref]:[password]@[pool-host]:5432/postgres"

# ------------------------------------------------------------
# JWT Authentication
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET="change-me-64-hex-chars-min"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-64-hex-chars-min"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------
# Redis (cache, BullMQ queue, hold expiry)
# ------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------
# Rate Limiting (NestJS Throttler)
# TTL in ms (60000 = 1 minute), LIMIT = max requests per window
# ------------------------------------------------------------
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

# ------------------------------------------------------------
# CORS & Frontend
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# Supabase (storage)
# ------------------------------------------------------------
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[supabase-service-role-key]"
SUPABASE_STORAGE_BUCKET="mobile-commerce"

# ------------------------------------------------------------
# Email (Brevo API by default; SMTP via opt-out) — unset = mock/console mode
# EMAIL_PROVIDER=brevo (default) | smtp (raw SMTP)
# ------------------------------------------------------------
EMAIL_PROVIDER="brevo"
EMAIL_FROM="MobileCommerce <no-reply@example.com>"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="[smtp-user]"
EMAIL_PASS="[smtp-app-password]"

# ------------------------------------------------------------
# Email via Brevo API (default provider)
# Get key at https://app.brevo.com/settings/keys/api-keys :
#   BREVO_API_KEY = SMTP & API key (starts with xkeysib-)
# Free plan: 300 emails/day, no credit card. Sender address must be
# validated under Brevo > Senders & IP, otherwise the API rejects.
# SMTP alternative (no code change): EMAIL_PROVIDER=smtp with
#   EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587,
#   EMAIL_USER=<login-email>, EMAIL_PASS=<smtp-key>.
# ------------------------------------------------------------
BREVO_API_KEY="[brevo-api-key]"

# ------------------------------------------------------------
# VietQR
# ------------------------------------------------------------
VIETQR_BANK_ID="970422"
VIETQR_ACCOUNT_NO="0123456789"
VIETQR_ACCOUNT_NAME="NGUYEN VAN A"

# ------------------------------------------------------------
# VNPay Sandbox
# ------------------------------------------------------------
VNPAY_TMN_CODE="[vnpay-tmn-code]"
VNPAY_HASH_SECRET="[vnpay-hash-secret]"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:5173/order/vnpay-return"

# ------------------------------------------------------------
# Google OAuth (canonical keys)
# Redirect URI must match the one registered in Google Console.
# ------------------------------------------------------------
GOOGLE_CLIENT_ID="[google-client-id].apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="[google-client-secret]"
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/oauth/callback"

# ------------------------------------------------------------
# Cloudflare R2 (media storage)
# ------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID="[r2-account-id]"
CLOUDFLARE_R2_BUCKET="[r2-bucket]"
CLOUDFLARE_R2_ACCESS_KEY_ID="[r2-access-key-id]"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="[r2-secret-access-key]"
CLOUDFLARE_R2_PUBLIC_URL="https://[public-id].r2.dev"
STORAGE_PROVIDER=r2

# ------------------------------------------------------------
# Gemini (AI chatbot)
# ------------------------------------------------------------
GEMINI_API_KEY="[gemini-api-key]"
GEMINI_MODEL=gemini-3.8-flash
CHATBOT_ENABLED=true
