VITE_API_URL=http://localhost:3000/api
# Production example: VITE_API_URL=https://phoneshop-api.onrender.com/api
VITE_R2_PUBLIC_URL=https://pub-xxx.r2.dev
# Same Web OAuth client ID as backend GOOGLE_CLIENT_ID. Required for Google Login.
VITE_GOOGLE_CLIENT_ID=
# Informational callback URI; current frontend does not read this variable.
# The backend GOOGLE_REDIRECT_URI controls the authorization-code redirect.
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/oauth/callback
